---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import WeekCalendar from '../components/WeekCalendar.astro';
import Icon from '../components/Icon.astro';
import {site} from '../data/site';
import '../styles/calendar.css';
---
<Layout title="Parish calendar"><PageIntro title="Worship and parish life." label="Parish calendar" description="Choose a week to see services, feast days, and parish gatherings. All times are local to Fort Myers, Florida (Eastern Time)."/>
  <div class="wrap page-body">
    <div class="section-heading"><div><p class="eyebrow">Our regular Sunday gathering</p><h2>Divine Liturgy · 9:30 am</h2></div><a class="text-link" href="/visit/">Planning your first visit? <Icon name="arrow" size={17}/></a></div>
    <p>Check the week below for Orthros, additional services, feast days, and changes to the regular schedule.</p>
    <WeekCalendar/>
    <div class="notice"><a class="text-link" href={`https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(site.calendarId)}`} target="_blank" rel="noopener">Open in Google Calendar <Icon name="northeast" size={16}/></a><p>To confirm a service time, call <a href="tel:+12392217537">{site.phone}</a>.</p></div>
    <a class="button button-outline" href={`https://calendar.google.com/calendar/ical/${encodeURIComponent(site.calendarId)}/public/basic.ics`}>Subscribe to the calendar <Icon name="calendar" size={18}/></a>
  </div>
</Layout>
