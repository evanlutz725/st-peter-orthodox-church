---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Sidebar from '../components/Sidebar.astro';
import Icon from '../components/Icon.astro';
import podcast from '../data/homilies.json';
const date=(s:string)=>new Date(s+'T12:00:00').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
---
<Layout title="Homilies"><PageIntro title="Listen. Reflect. Grow." label="Homilies of Father Hans" description="Weekly homilies from Father Hans Jacobse, offering spiritual guidance rooted in Holy Scripture and the life of the Orthodox Church."/><div class="wrap page-body content-grid"><div><div class="podcast-intro"><img src="/assets/who.webp" width="358" height="200" alt="Father Hans Jacobse preaching at St. Peter"/><div><p class="eyebrow">Scripture for everyday life</p><h2>Homilies of Father Hans</h2><p>Listen here, or follow the parish podcast in your favorite app.</p></div></div><div class="contact-links podcast-links"><a class="button" href="https://podcasts.apple.com/us/podcast/homilies-of-father-hans/id1867037828" target="_blank" rel="noopener">Apple Podcasts <Icon name="northeast" size={16}/></a><a class="button button-outline" href="https://music.amazon.com/podcasts/48eebfe4-de90-4d7e-b31e-d67888343fdd/homilies-of-father-hans" target="_blank" rel="noopener">Amazon Music <Icon name="northeast" size={16}/></a><a class="text-link" href={podcast.feed} target="_blank" rel="noopener">RSS feed <Icon name="northeast" size={15}/></a></div><div class="sermon-list">{podcast.episodes.map(s=><article class="sermon-card"><time datetime={s.date}>{date(s.date)}</time><h2>{s.title}</h2><p>{s.description}…</p><audio controls preload="none" aria-label={`Listen to ${s.title}`} src={s.audio}>Your browser does not support embedded audio. <a href={s.audio}>Open the recording</a>.</audio><a class="text-link" href={s.url} target="_blank" rel="noopener">Episode details <Icon name="northeast" size={16}/></a></article>)}</div></div><Sidebar/></div></Layout>
<style>.podcast-intro{display:flex;align-items:center;gap:25px}.podcast-intro img{width:160px;object-fit:cover}.podcast-intro h2{font-size:34px;line-height:1.15;margin-bottom:13px}.podcast-intro p{font-size:12px;margin-bottom:0;color:var(--muted)}.podcast-intro .eyebrow{font-size:8px;margin-bottom:12px}.podcast-links{margin-bottom:50px;align-items:center}.podcast-links .button{font-size:11px;gap:16px;min-height:45px;padding:11px 17px}.sermon-card p{font-size:12px;color:var(--muted)}audio{width:100%;margin:8px 0 20px;height:45px}.sermon-card .text-link{font-size:11px}@media(max-width:640px){.podcast-intro{flex-direction:column;align-items:flex-start}.podcast-intro img{width:220px}.podcast-intro h2{font-size:37px}.podcast-links{gap:13px}.sermon-card p{font-size:13px}}</style>
