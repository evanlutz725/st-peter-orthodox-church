---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import {site} from '../data/site';
---
<Layout title="Contact the parish">
  <PageIntro title="Let’s connect." label="Contact St. Peter" description="Planning a visit, looking for a church home, or have a question about the Orthodox faith? We would love to hear from you."/>
  <div class="wrap page-body">
    <div class="contact-intro"><h2>A conversation is<br/> a good place to begin.</h2><p>Call the church for parish information, help planning a visit, or to arrange a conversation with Father Hans.</p></div>
    <div class="info-grid contact-panels">
      <div class="info-panel"><p class="eyebrow">Church phone</p><h2>{site.phone}</h2><p>For all parish inquiries, including questions for Father Hans, please call the church.</p><a class="button" href={site.phoneHref}>Call the church <Icon name="arrow" size={17}/></a></div>
      <div class="info-panel"><p class="eyebrow">Visit or write</p><h2>Find us in<br/> Fort Myers.</h2><p>St. Peter Orthodox Church<br/>{site.address}<br/>{site.city}</p><a class="text-link" href={site.directions} target="_blank" rel="noopener">Get directions <Icon name="northeast" size={17}/></a></div>
    </div>
  </div>
</Layout>
<style>.contact-panels{grid-template-columns:repeat(2,minmax(0,1fr))}@media(max-width:700px){.contact-panels{grid-template-columns:minmax(0,1fr)}}</style>
