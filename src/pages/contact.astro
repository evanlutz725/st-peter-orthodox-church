---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import {site} from '../data/site';
---
<Layout title="Contact the parish"><PageIntro title="Let’s connect." label="Contact St. Peter" description="Planning a visit, looking for a church home, or have a question about the Orthodox faith? We would love to hear from you."/><div class="wrap page-body"><div class="contact-intro"><h2>A conversation is<br/>a good place to begin.</h2><p>Contact the parish office, or reach Father Hans directly. Text is the fastest way to reach Father Hans.</p></div><div class="info-grid"><div class="info-panel"><p class="eyebrow">Parish office</p><h2>{site.phone}</h2><p>For general questions, parish information, and help planning a visit.</p><a class="button" href="tel:+12392217537">Call the parish office <Icon name="arrow" size={17}/></a></div><div class="info-panel"><p class="eyebrow">Father Hans Jacobse</p><h2>(239) 248-4775</h2><p>Text is preferred. Reach out with questions or to arrange a conversation.</p><div class="contact-links"><a class="button" href="sms:+12392484775">Text Father Hans <Icon name="arrow" size={17}/></a><a class="text-link" href="tel:+12392484775">Call <Icon name="arrow" size={16}/></a></div></div><div class="info-panel"><p class="eyebrow">Visit or write</p><h2>Find us in<br/>Fort Myers.</h2><p>St. Peter Orthodox Church<br/>{site.address}<br/>{site.city}</p><a class="text-link" href={site.directions} target="_blank" rel="noopener">Get directions <Icon name="northeast" size={17}/></a></div></div></div></Layout>
