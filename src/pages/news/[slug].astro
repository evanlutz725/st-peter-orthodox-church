---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Sidebar from '../../components/Sidebar.astro';
import Icon from '../../components/Icon.astro';
import news from '../../data/news.json';
export function getStaticPaths(){return news.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;
const date=new Date(post.date+'T12:00:00').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
---
<Layout title={post.title} description={post.excerpt}><PageIntro title={post.title} label={`Parish newsletter · ${date}`}/><div class="wrap page-body content-grid"><div><article class="prose" set:html={post.html}/><div class="notice">This newsletter was published on {date}. For upcoming services and events, check the <a class="text-link" href="/calendar/">live parish calendar</a>.</div><a class="text-link" href={post.source} target="_blank" rel="noopener">Read the original newsletter <Icon name="northeast" size={15}/></a><br/><a class="text-link back-link" href="/news/">Back to parish news <Icon name="arrow" size={17}/></a></div><Sidebar/></div></Layout>
