---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
import news from '../../data/news.json';
const date=(s:string)=>new Date(s+'T12:00:00').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
---
<Layout title="Parish news"><PageIntro title="Life together." label="Parish news & newsletters" description="The latest newsletters, announcements, and reflections from our parish family."/><div class="wrap page-body"><div class="news-grid">{news.map((post,i)=><article class="news-card"><span class="news-category">PARISH NEWS <span>0{i+1}</span></span><time datetime={post.date}>{date(post.date)}</time><h2><a href={`/news/${post.slug}/`}>{post.title}</a></h2><p>{post.excerpt.length > 170 ? `${post.excerpt.slice(0,170).trim()}…` : post.excerpt}</p><a class="text-link" href={`/news/${post.slug}/`}>Read the newsletter <Icon name="arrow" size={17}/></a></article>)}</div><p class="notice" style="margin-top:45px">Looking for an earlier issue? <a class="text-link" href="https://stpeterorthodoxchurch.com/category/news/" target="_blank" rel="noopener">Browse the full parish newsletter archive <Icon name="northeast" size={15}/></a></p></div></Layout>
