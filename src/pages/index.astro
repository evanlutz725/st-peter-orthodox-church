---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import { site } from '../data/site';
import news from '../data/news.json';
import podcast from '../data/homilies.json';
import '../styles/home.css';
const date = (s:string)=>new Date(s+'T12:00:00').toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'});
const homily = podcast.episodes[0];
const parishNews = news.find(post => post.html.includes('id="parish-learning"') && post.html.includes('id="parish-mercy"'));
---
<Layout image="/assets/saint-peter-icon.webp" description="Visit St. Peter the Apostle Antiochian Orthodox Church in Fort Myers. Sunday Divine Liturgy at 9:30 am. Meet Father Hans, find service times, and plan your first visit.">
  <section class="hero home-hero" aria-labelledby="home-title">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">St. Peter the Apostle · Fort Myers, Florida</p>
        <h1 id="home-title">Come <em>and see.</em></h1>
        <p class="hero-description">Orthodox Christian worship in Fort Myers. A parish to call home. Join us this Sunday.</p>
        <p class="hero-service">Sunday Divine Liturgy <span>9:30 am</span></p>
        <div class="hero-actions"><a class="button" href="/visit/">Plan your visit <Icon name="arrow" size={18}/></a><a class="text-link" href="#this-week">Service times <Icon name="arrow" size={17}/></a></div>
        <a class="hero-address" href={site.directions} target="_blank" rel="noopener"><Icon name="pin" size={17}/><span>{site.address} · Fort Myers</span><Icon name="northeast" size={14}/></a>
      </div>
      <figure class="hero-image patron-icon"><img src="/assets/saint-peter-icon.webp" width="512" height="512" alt="Icon of Saint Peter the Apostle, patron of our parish, on a blue and gold background" fetchpriority="high"/><figcaption>Saint Peter the Apostle · Our patron saint</figcaption></figure>
    </div>
  </section>
  <UpcomingEvents/>
  <section class="wrap section parish-gallery" aria-label="Photographs from St. Peter"><figure><img src="/assets/parish-worship.webp" width="596" height="336" alt="Parishioners gathered for worship at St. Peter" loading="lazy"/><figcaption>Worship together · From our parish archive</figcaption></figure><figure><img src="/assets/parish-exterior.webp" width="500" height="362" alt="St. Peter Orthodox Church entrance on Hickory Drive" loading="lazy"/><figcaption>Our parish home · Hickory Drive, Fort Myers</figcaption></figure></section>
  <section class="section wrap first-visit" aria-labelledby="visit-title">
    <div><p class="eyebrow">Your first Sunday</p><h2 id="visit-title">A welcome.<br/> A place to <em>begin.</em></h2><p>You don’t need to know the prayers or customs to visit. Come as you are, follow along at your own pace, and introduce yourself after the service.</p><a class="text-link" href="/visit/">What to expect on your first visit <Icon name="arrow" size={18}/></a></div>
    <ol class="visit-steps">
      <li><span class="step-number" aria-hidden="true">01</span><div><h3>Come for worship</h3><p>Divine Liturgy begins at 9:30 am on Sundays. Check the calendar for the full service schedule.</p></div></li>
      <li><span class="step-number" aria-hidden="true">02</span><div><h3>Find your way here</h3><p>We’re on Hickory Drive, just off US 41. The central parking area is reserved for seniors and people with mobility needs.</p></div></li>
      <li><span class="step-number" aria-hidden="true">03</span><div><h3>Stay and meet us</h3><p>Join the parish for fellowship after worship. Bring your questions, and your family.</p></div></li>
    </ol>
  </section>
  <section class="pastor-section" aria-labelledby="pastor-title"><div class="wrap section pastor-grid">
    <figure class="pastor-photo"><img src="/assets/who.webp" width="358" height="200" alt="Father Hans Jacobse preaching at St. Peter" loading="lazy"/><figcaption>Father Hans Jacobse · Parish priest</figcaption></figure>
    <div class="pastor-copy"><p class="eyebrow">Meet our pastor</p><h2 id="pastor-title">A conversation is a<br/> <em>good place to start.</em></h2><p>Father Hans has shepherded St. Peter since its beginnings in 2008. Whether you’re exploring Orthodoxy, moving to the area, or returning to church, he welcomes your questions.</p><div class="pastor-actions"><a class="text-link" href="/about/#our-clergy">Get to know Father Hans <Icon name="arrow" size={17}/></a><a class="text-link" href="sms:+12392484775">Text Father Hans <Icon name="arrow" size={17}/></a></div></div>
  </div></section>
  <section class="section wrap parish-life" aria-labelledby="life-title">
    <div class="section-heading"><div><p class="eyebrow">Life in our parish</p><h2 id="life-title">Faith, lived <em>together.</em></h2></div><a class="text-link" href="/about/">Get to know St. Peter <Icon name="arrow" size={17}/></a></div>
    <div class="life-grid">
      <article class="life-story"><p class="eyebrow">Learning the faith</p><h3>Room for your questions.</h3><p>Our catechumen and enquirers class introduces the Orthodox faith through teaching and conversation. Families are welcome.</p><a class="text-link" href={parishNews ? `/news/${parishNews.slug}/#parish-learning` : '/news/'}>Read about the class <Icon name="arrow" size={17}/></a></article>
      <article class="life-story"><p class="eyebrow">Caring for one another</p><h3>Bearing one another’s burdens.</h3><p>The Good Samaritan Mercy Fund helps parishioners facing hardship. It is one way our community puts love of neighbor into practice.</p><a class="text-link" href={parishNews ? `/news/${parishNews.slug}/#parish-mercy` : '/news/'}>Learn about the mercy fund <Icon name="arrow" size={17}/></a></article>
      <article class="life-story"><p class="eyebrow">Our story</p><h3>From a little room to a parish home.</h3><p>St. Peter began in a room at a local Holiday Inn. Prayer, perseverance, and a growing parish family brought us to Hickory Drive.</p><a class="text-link" href="/about/#our-story">Read our parish story <Icon name="arrow" size={17}/></a></article>
    </div>
  </section>
  <section class="homily-feature" aria-labelledby="homily-title"><div class="wrap section homily-grid"><div><p class="eyebrow">From the pulpit</p><h2 id="homily-title">Listen and <em>reflect.</em></h2><p>Scripture and the life of the Church, with Father Hans.</p><a class="text-link" href="/homilies/">Browse all homilies <Icon name="arrow" size={17}/></a></div><article class="home-homily"><time datetime={homily.date}>{date(homily.date)}</time><h3>{homily.title}</h3><audio controls preload="none" aria-label={`Listen to ${homily.title}`} src={homily.audio}>Your browser does not support embedded audio. <a href={homily.audio}>Open the recording</a>.</audio><a class="text-link" href={homily.url} target="_blank" rel="noopener">Episode details <Icon name="northeast" size={15}/></a></article></div></section>
  <section class="section wrap home-news" aria-labelledby="news-title"><div><p class="eyebrow">Keep in touch</p><h2 id="news-title">Parish <em>news.</em></h2></div><article><time datetime={news[0].date}>{date(news[0].date)}</time><h3><a href={`/news/${news[0].slug}/`}>{news[0].title}</a></h3><p>Services, announcements, and news from our parish family.</p></article><a class="text-link" href="/news/">Read the newsletters <Icon name="arrow" size={17}/></a></section>
</Layout>
