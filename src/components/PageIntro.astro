---
const { title, label = 'St. Peter Orthodox Church', description } = Astro.props;
---
<section class="page-intro"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{title}</span></div><p class="eyebrow">{label}</p><h1>{title}</h1>{description && <p>{description}</p>}</div></section>
