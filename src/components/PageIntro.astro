---
const { title, label = 'St. Peter Orthodox Church', description, parent } = Astro.props;
---
<section class="page-intro"><div class="wrap"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{parent && <><a href={parent.href}>{parent.label}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{title}</span></nav><p class="eyebrow">{label}</p><h1>{title}</h1>{description && <p>{description}</p>}</div></section>
